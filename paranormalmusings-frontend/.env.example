# Where the admin (and its content API) is running.
ADMIN_API_URL=http://localhost:3001

# Seconds the fetched content is cached for. The admin also pings
# /api/revalidate after every save, so this is only the backstop.
CONTENT_REVALIDATE=60

# Must match REVALIDATE_SECRET in the admin's .env.local.
REVALIDATE_SECRET=change-me-three

# Production only. The directory the admin uploads into — the same path it has
# as UPLOAD_DIR. Serves /media/<file>. Unset locally, where uploads go straight
# into public/images.
# MEDIA_DIR=/home/uXXXXXXXX/pm-data/media
