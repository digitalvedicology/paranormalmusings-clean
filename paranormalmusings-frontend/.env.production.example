# ═══════════════════════════════════════════════════════════════════════════════
# PARANORMAL MUSINGS - FRONTEND PRODUCTION ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in your production values

# ──────────────────────────────────────────────────────────────────────────────
# CRITICAL: ADMIN API CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# This must point to your production admin URL
ADMIN_API_URL=https://admin.paranormalmusings.com

# Cache revalidation time in seconds (3600 = 1 hour for production)
CONTENT_REVALIDATE=3600

# Must match REVALIDATE_SECRET in admin .env.production
# IMPORTANT: Use a strong, random secret string
REVALIDATE_SECRET=your-secure-production-revalidate-secret-change-me

# ──────────────────────────────────────────────────────────────────────────────
# FILE STORAGE (Hostinger)
# ──────────────────────────────────────────────────────────────────────────────
# Path where uploaded media files are stored on your server
MEDIA_DIR=/home/paranormalmusings/public_html/media

# ──────────────────────────────────────────────────────────────────────────────
# SECURITY: CLOUDFLARE TURNSTILE (Spam Protection)
# ──────────────────────────────────────────────────────────────────────────────
# Get these from: https://dash.cloudflare.com/profile/api-tokens
# Public key (safe to expose)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_KEY=your_cloudflare_public_key_here

# Secret key (keep private on server only)
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_cloudflare_secret_key_here

# ──────────────────────────────────────────────────────────────────────────────
# EMAIL DELIVERY (Resend)
# ──────────────────────────────────────────────────────────────────────────────
# Email recipient for contact form submissions
CONTACT_EMAIL_TO=paranormalmusings@proton.me

# Resend API key for email delivery
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_your_resend_api_key

# ──────────────────────────────────────────────────────────────────────────────
# ANALYTICS
# ──────────────────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-your_ga4_measurement_id

# ──────────────────────────────────────────────────────────────────────────────
# NOTES
# ──────────────────────────────────────────────────────────────────────────────
# This file should NOT be committed to version control
# Store it securely on your server
# Keep all secret keys safe and rotate them regularly
# Update these values before deploying to production
