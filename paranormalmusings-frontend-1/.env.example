# Where the admin (and its content API) is running.
ADMIN_API_URL=http://localhost:3001

# Seconds the fetched content is cached for. The admin also pings
# /api/revalidate after every save, so this is only the backstop.
CONTENT_REVALIDATE=60

# Must match REVALIDATE_SECRET in the admin's .env.local.
REVALIDATE_SECRET=change-me-three

# Production only. The directory the admin uploads into — the same path it has
# as UPLOAD_DIR. Serves /media/<file>. Unset locally, where uploads go straight
# into public/images.
# MEDIA_DIR=/home/uXXXXXXXX/pm-data/media

# ──────────────────────────────────────────────────────────────────────────────
# CONTACT FORM CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Cloudflare Turnstile (spam protection)
# Get from: https://dash.cloudflare.com/profile/api-tokens
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_KEY=your_public_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_secret_key_here

# Email delivery (Resend)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Email recipient for contact form submissions
CONTACT_EMAIL_TO=paranormalmusings@proton.me

# ──────────────────────────────────────────────────────────────────────────────
# ANALYTICS CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Google Analytics 4
# Get from: https://analytics.google.com (Measurement ID format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
