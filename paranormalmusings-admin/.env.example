# The one password that unlocks the admin UI. Change it before deploying.
ADMIN_PASSWORD=change-me

# Shared secret the frontend sends on write/preview requests. Reads of
# /api/content are public so the site can render without a key.
ADMIN_API_KEY=change-me-too

# Where the public site lives — used by the "View on site" links and by the
# revalidate ping fired after every save.
SITE_URL=http://localhost:3000

# Must match REVALIDATE_SECRET in the frontend's .env.local.
REVALIDATE_SECRET=change-me-three

# Production only. Keeps the content document outside the deployed folder so a
# redeploy cannot overwrite it. Unset locally, where data/content.json is fine.
# DATA_DIR=/home/uXXXXXXXX/pm-data

# Production only. Uploads must also live outside the deployed folder, and the
# site serves them from the same path via MEDIA_DIR.
# UPLOAD_DIR=/home/uXXXXXXXX/pm-data/media
# MEDIA_BASE_URL=/media
#
# If the two apps cannot share a folder — some hosts isolate each app — point
# MEDIA_BASE_URL at this app instead and drop MEDIA_DIR from the site. Stored
# URLs become absolute, so no shared filesystem is needed.
# MEDIA_BASE_URL=https://admin.example.com/api/media/file
