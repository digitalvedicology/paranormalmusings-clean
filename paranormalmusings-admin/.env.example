# The one password that unlocks the admin UI. Change it before deploying.
ADMIN_PASSWORD=change-me

# Shared secret the frontend sends on write/preview requests. Reads of
# /api/content are public so the site can render without a key.
ADMIN_API_KEY=change-me-too

# Where the public site lives — used by the "View on site" links and by the
# revalidate ping fired after every save.
SITE_URL=http://localhost:3000

# Must match REVALIDATE_SECRET in the frontend's .env.local.
REVALIDATE_SECRET=change-me-three
