# ═══════════════════════════════════════════════════════════════════════════════
# PARANORMAL MUSINGS - ADMIN PRODUCTION ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in your production values

# ──────────────────────────────────────────────────────────────────────────────
# ADMIN SECURITY
# ──────────────────────────────────────────────────────────────────────────────
# Admin login password (used for /admin access)
# IMPORTANT: Use a strong, random password
ADMIN_PASSWORD=your-secure-admin-password-change-me

# API key for content revalidation requests from frontend
# IMPORTANT: Use a strong, random secret string
ADMIN_API_KEY=your-secure-api-key-change-me

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND INTEGRATION
# ──────────────────────────────────────────────────────────────────────────────
# Frontend URL (used for revalidation requests)
SITE_URL=https://frontend.paranormalmusings.com

# Revalidation secret (must match REVALIDATE_SECRET in frontend .env.production)
# IMPORTANT: Keep this in sync with frontend configuration
REVALIDATE_SECRET=your-secure-production-revalidate-secret-change-me

# ──────────────────────────────────────────────────────────────────────────────
# FILE STORAGE (Hostinger)
# ──────────────────────────────────────────────────────────────────────────────
# Where user uploads are stored
# Must be accessible from SITE_URL at /media/
UPLOAD_DIR=/home/paranormalmusings/public_html/media

# ──────────────────────────────────────────────────────────────────────────────
# NOTES
# ──────────────────────────────────────────────────────────────────────────────
# This file should NOT be committed to version control
# Store it securely on your server
# Keep all secret keys safe and rotate them regularly
# Update these values before deploying to production
#
# SECURITY CHECKLIST:
# [ ] ADMIN_PASSWORD is strong (25+ chars, mixed case, numbers, symbols)
# [ ] ADMIN_API_KEY is strong and unique
# [ ] REVALIDATE_SECRET matches frontend configuration
# [ ] SITE_URL points to live frontend URL
# [ ] UPLOAD_DIR exists and is writable by the Node.js process
# [ ] All secrets are stored securely and not shared
