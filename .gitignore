# Dependencies and build output live in each app's own .gitignore too; these
# catch anything that lands at the root.
node_modules
.next
out
build

# Secrets. Every real value lives in a .env.local that never leaves the machine
# — the committed .env.example files carry placeholders only.
.env
.env.local
.env.production
.env.*.local

# Editor and OS noise
.DS_Store
Thumbs.db
.vscode
.idea
*.log
*.tsbuildinfo

# Uploaded files and data (dynamic, not code)
# Keep the seed file (content.json) but ignore runtime data
paranormalmusings-admin/data/contact-messages.json
paranormalmusings-admin/data/newsletter-subscribers.json
